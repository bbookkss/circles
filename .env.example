# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable (anon) key. Safe in the browser; RLS does the gating.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only Supabase key used by the admin client (account deletion, cron).
SUPABASE_SERVICE_ROLE_KEY=
# Newer name for the same server key. Set this or SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=

# Mapbox public token for the maps. Restrict it by URL in the Mapbox console.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Base URL for links in outgoing email. Defaults to https://hicircles.com.
NEXT_PUBLIC_SITE_URL=

# Resend API key. Without it, email sending is disabled.
RESEND_API_KEY=
# Sender address. Defaults to Circles <reminders@send.hicircles.com>.
EMAIL_FROM=
# Reply-To for outgoing email. Defaults to info@hicircles.com.
EMAIL_REPLY_TO=
# Where the in-app feedback form is delivered.
FEEDBACK_TO=

# Bearer token the reminder cron must present. The route refuses to run without it.
CRON_SECRET=

# Postgres connection string. Read only by supabase/apply.sh, not by the app.
SUPABASE_DB_URL=

# --- AI agents (docs/agents/) ---
# Development only: stands in for both keys below when they are unset. Ignored in production.
ANTHROPIC_API_KEY=
# Public search key. Give it its own Anthropic workspace with a monthly spend limit.
ANTHROPIC_API_KEY_PUBLIC=
# Ask Circles key, in a separate workspace, so a flood on public search can't take it down.
ANTHROPIC_API_KEY_ASSISTANT=
# Cloudflare Turnstile server secret. Without it, public search refuses every request in production.
TURNSTILE_SECRET_KEY=
# Cloudflare Turnstile site key for the widget on the landing page.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional limit overrides (defaults in src/lib/ai/limits.ts). Tighten in Vercel during a flood.
# Public searches per IP (IPv6 by /64) per hour.
AI_PUBLIC_PER_IP_HOUR=
# Public searches per IP per day.
AI_PUBLIC_PER_IP_DAY=
# Public searches per day across all visitors.
AI_PUBLIC_GLOBAL_DAY=
# Public search tokens per day across all visitors.
AI_PUBLIC_GLOBAL_TOKENS_DAY=
# Ask Circles messages per user per hour.
AI_ASSISTANT_PER_USER_HOUR=
# Ask Circles messages per user per day.
AI_ASSISTANT_PER_USER_DAY=
# Ask Circles tokens per user per day.
AI_ASSISTANT_USER_TOKENS_DAY=
# Ask Circles messages per day across all users.
AI_ASSISTANT_GLOBAL_DAY=
# Ask Circles tokens per day across all users.
AI_ASSISTANT_GLOBAL_TOKENS_DAY=
